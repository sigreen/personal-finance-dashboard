apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: default
type: Opaque
stringData:
  # WARNING: These are default development credentials
  # Change these values before deploying to production!
  POSTGRES_DB: finance_db
  POSTGRES_USER: finance_user
  POSTGRES_PASSWORD: finance_dev_password_change_me
  # Connection string for applications
  DATABASE_URL: postgresql://finance_user:finance_dev_password_change_me@postgres:5432/finance_db
